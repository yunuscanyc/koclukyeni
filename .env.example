# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# ÇOKLU ANAHTAR HAVUZU DESTEĞİ:
# Birden fazla Google Gemini API anahtarını aralarına virgül (,) koyarak ekleyebilirsiniz:
# Örn: GEMINI_API_KEY="AIzaSyA...,AIzaSyB...,AIzaSyC..."
# VEYA GEMINI_API_KEYS="AIzaSyA...,AIzaSyB..."
# VEYA GEMINI_API_KEY_1="AIzaSy...", GEMINI_API_KEY_2="AIzaSy..."
# Sistem istekleri anahtarlar arasında eşit dağıtır (Round-Robin) ve kota dolduğunda anında diğer anahtara geçer.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# (Opsiyonel) GROQ_API_KEY: Ücretsiz ultra hızlı Llama 3.2 90B/11B Vision & Llama 3.3 70B için
GROQ_API_KEY=""

# (Opsiyonel) OPENROUTER_API_KEY: Ücretsiz Qwen 2.5 VL 72B & DeepSeek R1 hibrit modeller için
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL connection options (Supports either a full DATABASE_URL or individual PG* variables)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

PGHOST="localhost"
PGPORT=5432
PGUSER="postgres"
PGPASSWORD="password"
PGDATABASE="yks_coaching_db"

